{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      ".read": true,
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "$code.matches(/^[A-Z]{4}$/)"
      }
    },
    "global": {
      "tiers": {
        ".read": true,
        ".write": true
      },
      "images": {
        ".read": true,
        ".write": true,
        "$card": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 300000"
        }
      },
      "players": {
        ".read": true,
        ".write": true,
        "$k": {
          ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 24"
        }
      },
      "history": {
        ".read": true,
        ".write": true,
        "$id": {
          ".validate": "newData.hasChildren(['date','players'])"
        }
      },
      "elo": {
        ".read": true,
        ".write": true
      }
    }
  }
}
