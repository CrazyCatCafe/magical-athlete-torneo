{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      ".read": true,
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "$code.matches(/^[A-Z]{4}$/)"
      }
    },
    "global": {
      "tiers": {
        ".read": true,
        ".write": true
      },
      "images": {
        ".read": true,
        ".write": true,
        "$card": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 300000"
        }
      }
    }
  }
}
